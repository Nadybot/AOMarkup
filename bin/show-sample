#!/usr/bin/env php
<?php declare(strict_types=1);

// Print a sample's expected output in the terminal, e.g. "bin/show-sample 03-aggdef ansi"

require __DIR__ . '/../vendor/autoload.php';

use AO\Markup\Tests\Support\AnsiNotation;

$sample = $argv[1] ?? null;
$format = $argv[2] ?? 'ansi';
$dir = __DIR__ . '/../tests/Samples';
if ($sample === null) {
	fwrite(STDERR, "Usage: {$argv[0]} <sample> [ansi|txt|aoml|bbml|lepanel|html|discord.json|aoxml|legacy]\n");
	fwrite(STDERR, 'Samples: ' . implode(', ', array_map('basename', glob("{$dir}/*", GLOB_ONLYDIR) ?: [])) . "\n");
	exit(1);
}
$file = match ($format) {
	'aoxml' => "{$dir}/{$sample}/input.aoxml",
	'legacy' => "{$dir}/{$sample}/legacy.bbml",
	default => "{$dir}/{$sample}/expected.{$format}",
};
$content = file_get_contents($file);
if ($content === false) {
	fwrite(STDERR, "Cannot read {$file}\n");
	exit(1);
}
echo $format === 'ansi' ? AnsiNotation::toEscapes($content) : $content;
