{
  "name": "nadybot/aomarkup",
  "description": "AoXML: a structured markup language for Anarchy Online bots, with importers and exporters for AOML, lepanel, ANSI, plain text, HTML and Discord",
  "keywords": [
    "anarchy-online",
    "aoml",
    "markup",
    "bot"
  ],
  "authors": [
    {
      "name": "Nadyita",
      "email": "nadyita@hodorraid.org",
      "homepage": "https://nadybot.org",
      "role": "Developer"
    }
  ],
  "type": "library",
  "require": {
    "php": ">=8.1.17",
    "ext-mbstring": "*",
    "thecodingmachine/safe": "^2.0|^3.0",
    "psr/log": "^1|^2|^3"
  },
  "suggest": {
    "league/commonmark": "Required for the Markdown importer"
  },
  "autoload": {
    "psr-4": {
      "AO\\Markup\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AO\\Markup\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "beste/psr-testlogger": "^1.0",
    "composer-phar/php-cs-fixer": "^3.51.0",
    "league/commonmark": "^2.8",
    "nadybot/nadystyle": "^1.0.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.8",
    "thecodingmachine/phpstan-safe-rule": "^1.4"
  },
  "license": [
    "AGPL-3.0-or-later"
  ],
  "scripts": {
    "tests": [
      "phpunit -c phpunit.xml",
      "phpstan analyse --memory-limit 512M --no-progress --no-ansi",
      "phpcs --no-colors --report=checkstyle -q src tests",
      "(command -v mago && mago lint) || true"
    ]
  }
}
